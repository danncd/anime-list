{
  "name": "anime-list",
  "productName": "Anime List",
  "private": true,
  "version": "0.1.0",
  "description": "A desktop anime and manga database explorer, with your own lists.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "package": "npm run build && node scripts/package-app.mjs",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "electron": "npm run build && npm run brand && electron .",
    "brand": "node scripts/brand-electron.cjs",
    "electron:dev": "npm run brand && VITE_DEV_SERVER_URL=http://localhost:1420 electron ."
  },
  "dependencies": {
    "@fontsource/sora": "^5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "42.11.1",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
